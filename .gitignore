# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/public/uploads/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# prisma
# Local SQLite dev database + journal / write-ahead files must NEVER
# be committed. Migration files under prisma/migrations/ are tracked.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
/prisma/migrations/dev.db*
# Transient SQLite backups (e.g. taken before the Postgres migration)
# stay on disk locally but never enter version control.
/prisma/*.db.backup-*
/prisma/dev.db.backup-*

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

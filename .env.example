# ── Database ──────────────────────────────────────────────────────
# Local dev uses SQLite by default. The provider in prisma/schema.prisma
# is set to "sqlite" and the initial migration was authored against it.
#
# DEV (SQLite, default — matches the checked-in schema)
DATABASE_URL="file:./dev.db"
#
# PROD (Postgres — Neon / Vercel Postgres / etc.)
# To switch, change `datasource db { provider = "sqlite" }` in
# prisma/schema.prisma to `provider = "postgresql"`, drop the SQLite
# migrations under prisma/migrations, run `npx prisma migrate dev --name init`
# against your Postgres URL, then re-seed. Example URL shape:
# DATABASE_URL="postgresql://user:password@host:5432/lions?schema=public"

# ── Seed admin account ────────────────────────────────────────────
# `npm run db:seed` refuses to run without these. Password must be
# at least 12 characters. Rotate immediately after the first login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-set-a-strong-passphrase

# ── Public site URL ───────────────────────────────────────────────
# Used by robots.ts and sitemap.ts to emit absolute URLs. Set this
# per-environment: http://localhost:3000 in dev, the real origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── IGPL sync cron ────────────────────────────────────────────────
# Protects /api/sync/igpl. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=change-me-too

# Enable the sync only once a real IGPL source is wired in a later milestone.
# Until then the endpoint short-circuits and vercel.json has no cron entry.
IGPL_SYNC_ENABLED=false

# When wiring the real scraper:
# IGPL_URL=https://example-igpl-tournament-page

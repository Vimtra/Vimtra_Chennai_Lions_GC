# ── Database (required) ──────────────────────────────────────────
# Postgres connection string (Neon / Vercel Postgres / local).
# After setting it:  npx prisma migrate dev --name init  &&  npm run db:seed
DATABASE_URL="postgresql://user:password@host:5432/lions?schema=public"

# ── Seed admin account ───────────────────────────────────────────
# `npm run db:seed` creates/promotes this user to ADMIN. CHANGE before deploying.
ADMIN_EMAIL=admin@vimtrachennailions.gc
ADMIN_PASSWORD=lions2026

# ── IGPL sync cron ───────────────────────────────────────────────
# Protects /api/sync/igpl. Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=change-me-too

# When wiring the real scraper:
# IGPL_URL=https://example-igpl-tournament-page

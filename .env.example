# Database
#
# Default Prisma commands and Vercel builds use PostgreSQL. The provider in
# prisma/schema.prisma is set to "postgresql" with a PostgreSQL M0-M4 baseline.
#
# Two URLs are required for the Postgres path (Neon+Vercel+Prisma recipe):
#   DATABASE_URL — the POOLED Neon connection (hostname contains "-pooler");
#                  used by Prisma at runtime for serverless requests.
#   DIRECT_URL   — the DIRECT Neon connection (no "-pooler" in hostname);c
#                  used by `prisma migrate deploy` and other schema ops.
#
# The previous local SQLite setup is preserved for deliberate local use.
# Locally, use these values (identical strings satisfy Prisma validation
# even though the schema.prisma provider is "postgresql"; local dev
# actually goes through schema.sqlite.prisma via the db:sqlite:* scripts):
#   DATABASE_URL="file:./dev.db"
#   DIRECT_URL="file:./dev.db"
#   npm run db:sqlite:generate
#   npm run db:sqlite:migrate
#   npm run db:sqlite:seed
# SQLite migrations are preserved under prisma/migrations_sqlite.

# Seed admin account
#
# `npm run db:seed` refuses to run without these. Password must be at least
# 12 characters. Rotate immediately after the first login.
#
# ADMIN_EMAIL doubles as the default recipient for contact-form
# notifications (see CONTACT_NOTIFY_EMAIL below) — no separate variable
# is required unless you want enquiries routed somewhere else.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-set-a-strong-passphrase

# Contact form — outbound email (Gmail SMTP)
#
# Two emails are sent after a successful /contact submission: a
# confirmation to the enquirer, and a notification to the franchise. Both
# are skipped — not sent, never thrown, never surfaced to the visitor —
# when SMTP_HOST, SMTP_USER, SMTP_PASSWORD or MAIL_FROM is absent. The
# enquiry is saved to the database either way; email is best-effort on
# top of that, never a precondition for it. See lib/mail.ts and
# lib/email-templates.ts.
#
#   SMTP_HOST            — smtp.gmail.com
#   SMTP_PORT             — 465 (Gmail's implicit-TLS port)
#   SMTP_SECURE           — true for port 465
#   SMTP_USER             — the Gmail address sending the mail
#   SMTP_PASSWORD         — a Gmail *App Password*
#                           (myaccount.google.com/apppasswords, requires
#                           2-Step Verification) — never the account's
#                           normal login password, and never committed
#                           anywhere in this repo
#   MAIL_FROM             — the From: address; normally the same address
#                           as SMTP_USER
#   CONTACT_NOTIFY_EMAIL  — where enquiry notifications go; optional,
#                           falls back to ADMIN_EMAIL when unset
#
# lib/mail.ts's sendOrderReceipt() (commerce, unrelated to the contact
# form) also reads SMTP_HOST + MAIL_FROM for its own dormant gate, but
# both of its branches return `sent: false` regardless — it still never
# sends anything; see that function's own comment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_NOTIFY_EMAIL=

# Public site URL
#
# Used by robots.ts and sitemap.ts to emit absolute URLs. Set this
# per-environment: http://localhost:3000 in dev, the real origin in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IGPL sync cron
#
# Protects /api/sync/igpl. Vercel Cron sends it as:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-too

# Enable the sync only once a real IGPL source is wired in a later milestone.
# Until then the endpoint short-circuits and vercel.json has no cron entry.
IGPL_SYNC_ENABLED=false

# When wiring the real scraper:
# IGPL_URL=https://example-igpl-tournament-page

// Vimtra Chennai Lions GC — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  // ------- Email / phone verification (M6) -------
  // Both null on every pre-existing account — accurate, not backfilled:
  // no account verified under this system before it existed. Neither
  // gates sign-in, checkout, or admin access (see the actions/routes
  // that read them for exactly where they DO matter).
  emailVerifiedAt DateTime?
  phone           String? // E.164-ish, set when an OTP is requested for it
  phoneVerifiedAt DateTime? // cleared whenever a new OTP is requested for a
  //                            different/changed number — see lib/verification.ts
  // ------- end M6 additions -------
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  // M5 commerce back-relations (see Address, Order below).
  addresses    Address[]
  orders       Order[]
  // M6 back-relations (see EmailVerificationToken, PhoneOtp below).
  emailVerificationTokens EmailVerificationToken[]
  phoneOtps               PhoneOtp[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------
// M6 — Email + phone verification.
//
// Dedicated, single-purpose tables rather than raw token/OTP columns on
// User: neither is queried outside lib/verification.ts, and keeping them
// off User means a leaked/dumped User row never carries a live secret.
// Only a SHA-256 hash of the token/code is ever stored — see
// lib/verification.ts for why a keyed hash isn't used (no extra secret
// to manage) and for the cooldown/attempt-limit logic built on top of
// these rows.
// ---------------------------------------------------------------

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256(raw token); the raw token only ever exists in the emailed link
  expiresAt DateTime
  usedAt    DateTime? // set once, on first successful consumption — makes the token single-use
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PhoneOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String // the number this code was issued for
  codeHash   String // sha256(raw 6-digit code)
  attempts   Int       @default(0) // failed verify attempts against this row; capped in lib/verification.ts
  expiresAt  DateTime
  consumedAt DateTime? // set once, on first successful verification — makes the code single-use
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Product {
  id          String   @id // URL-friendly slug
  name        String
  cat         String
  price       Int // integer rupees (INR) — consistent with existing rows
  glyph       String
  img         String? // legacy single-image field kept for M0-M4 compatibility;
  //                     new code should populate `images` and treat `img` as fallback
  range       String
  desc        String
  // ------- M5 additions -------
  stock       Int      @default(0) // available inventory; 0 = out of stock
  active      Boolean  @default(true) // hide without deleting
  images      String[] @default([]) // ordered image URLs; first = primary
  weightGrams Int? // shipping weight (grams); optional
  sku         String? // optional stock-keeping unit / barcode
  // ------- end M5 additions -------
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

// ---------------------------------------------------------------
// IGPL — fixtures, scores, and season standings.
//
// Fixtures are the tournament calendar; Scores are player rounds inside a
// fixture; Standings are per-season, per-board leaderboards (team table,
// player of the season, order of merit). Admins hand-key each of these
// today; a future scrape (gated by IGPL_SYNC_ENABLED) will upsert into the
// same tables.
// ---------------------------------------------------------------

enum FixtureStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

model Fixture {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  leg         String? // e.g. "African Swing", "Season Opener"
  presentedBy String? // e.g. "Vimtra Chennai Lions GC"
  dateStart   DateTime
  dateEnd     DateTime?
  city        String
  country     String
  courseName  String?
  status      FixtureStatus @default(UPCOMING)
  note        String? // small line under the fixture ("Hosted by …")
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  scores      Score[]
}

model Score {
  id         String   @id @default(cuid())
  fixtureId  String
  fixture    Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  playerName String
  round      Int      @default(1)
  position   String?
  r1         String?
  r2         String?
  r3         String?
  r4         String?
  thru       String?
  today      String?
  total      String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([fixtureId])
}

enum StandingBoard {
  TEAM
  PLAYER
  ORDER
}

model Standing {
  id         String        @id @default(cuid())
  seasonYear Int
  board      StandingBoard
  rank       Int
  name       String // team name / player name
  teamName   String? // for PLAYER / ORDER boards, the player's franchise
  points     Int?
  extra      String? // JSON-encoded auxiliary columns kept as String for M0-M4 compatibility
  updatedAt  DateTime      @updatedAt

  @@unique([seasonYear, board, rank])
}

// ---------------------------------------------------------------
// News — franchise editorial (see M4 report).
//
// Draft/Published/Archived workflow. Public /news and /news/[slug] only
// ever surface PUBLISHED rows; Draft and Archived remain admin-only.
// bodyJson round-trips the TipTap editor state; bodyHtml is pre-rendered
// so the public page never loads editor libraries.
// ---------------------------------------------------------------

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String?
  coverImage  String? // /public path today; signed URL later
  bodyHtml    String // pre-rendered HTML for /news/[slug]
  bodyJson    String? // TipTap JSON document, for round-trip editing
  category    String? // free-text label ("Feature", "Player News", etc.)
  authorName  String // typed byline; not a User FK
  status      PostStatus @default(DRAFT)
  publishedAt DateTime? // set on Draft → Published transition
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

// ---------------------------------------------------------------
// Media Coverage — third-party press mentions of the franchise.
//
// Distinct from Post on purpose: we never host the source article, we
// only link out. Row = curated attribution + short original summary +
// deep link to the external publisher.
// ---------------------------------------------------------------

enum MediaKind {
  OFFICIAL // the league's or the franchise's own reporting — rendered under OFFICIAL NEWS
  ARTICLE  // third-party press — rendered under MEDIA COVERAGE
  SOCIAL   // social-platform post
}

model MediaCoverage {
  id          String    @id @default(cuid())
  kind        MediaKind @default(ARTICLE) // press article vs social-platform post
  sourceName  String // "The Hindu", "Times of India", "Instagram", ...
  sourceUrl   String // full external URL
  title       String // headline as published by the source
  summary     String // our short original summary (1–3 sentences)
  publishedAt DateTime? // source publish date, when verified
  coverImage  String? // /public path to the cover image, optional
  // Editorial state. `active` is kept alongside it and is always derived
  // (active = status == PUBLISHED) by lib/media-coverage.ts, so every
  // existing `active: true` query keeps returning exactly the published set.
  status      PostStatus @default(PUBLISHED)
  active      Boolean   @default(true) // derived from status — see above
  featuredOnHome Boolean @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, kind, sortOrder])
  @@index([status, kind, sortOrder])
  @@index([featuredOnHome, status, kind, sortOrder])
}

// ---------------------------------------------------------------
// Contact — /contact enquiries.
//
// One row per submission. `category` is a free-text label rather than an
// enum, same choice as Post.category — the canonical set of topics lives
// in components/contact/topics.ts (CONTACT_TOPICS) and is validated
// against there at submission time, so adding a topic never needs a
// migration. Deliberately minimal: no IP address, no user-agent, no
// referrer — nothing beyond what an admin needs to read and answer the
// enquiry (CLAUDE.md's data-integrity rule reads narrowly here too: don't
// collect what wasn't asked for).
// ---------------------------------------------------------------

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String? // optional on the form
  city      String? // optional on the form
  category  String // one of CONTACT_TOPICS at submission time
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// M5 — Commerce (Address, Order, OrderItem).
//
// Buyer flow: /shop -> /product/[id] -> /cart -> /checkout -> Order.
// Order.shippingSnapshot freezes the delivery address at order time so
// later edits to the source Address row don't retro-change history. The
// snapshot lives in a Json (Postgres jsonb) column. Product line-items
// are also snapshotted (name, image, unit price) on OrderItem for the
// same reason.
//
// Payment is deliberately un-live for M5 — PaymentMethod.ONLINE_TBD is
// a scaffolded slot so a future Razorpay/Stripe hook is a swap not a
// rewrite. Today the buyer picks COD or OFFLINE_INVOICE only.
// ---------------------------------------------------------------

enum OrderStatus {
  PENDING // just placed, awaiting admin action
  PAYMENT_PENDING // offline invoice sent, waiting on customer payment
  PAID // marked paid by admin (or by future gateway callback)
  PROCESSING // being prepared for dispatch
  SHIPPED // handed to logistics
  DELIVERED // received by customer
  CANCELLED // cancelled by user or admin
  REFUNDED // fully refunded
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD // cash on delivery
  OFFLINE_INVOICE // bank transfer / offline reconciliation
  ONLINE_TBD // scaffolded slot for a future online-payment integration
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String? // "Home", "Office" — optional short label
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]  @relation("OrderShipping")

  @@index([userId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // human-friendly, e.g. "VCL-260822-A1B2C"
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  // Soft FK to the source Address (SET NULL on delete so orders survive
  // address deletion). The frozen `shippingSnapshot` is the authoritative
  // "what did we actually ship to?" for display + fulfilment.
  shippingAddressId String?
  shippingAddress   Address?      @relation("OrderShipping", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingSnapshot  Json // frozen full address at time of order
  contactEmail      String
  contactPhone      String
  subtotal          Int // sum of item lineTotals, in whole INR
  shipping          Int           @default(0) // shipping fee, whole INR
  tax               Int           @default(0) // GST, whole INR
  total             Int // subtotal + shipping + tax
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID)
  paymentMethod     PaymentMethod
  paymentRef        String? // future: gateway reference / bank txn id
  notes             String? // free-text admin/customer notes
  // Idempotency key generated once per checkout attempt on the client
  // (CheckoutFlow) and resubmitted unchanged on every retry of that same
  // attempt (double-click, browser retry, resumed request after a
  // timeout). NULL for any order placed before this column existed, and
  // for anything created outside placeOrderAction (e.g. the test
  // harness), which never sets it. The @unique constraint is what makes
  // placeOrder()'s idempotency check race-safe, not just best-effort.
  clientRequestId     String?   @unique
  // Set once each Cash on Delivery email has actually sent for this
  // order, so a retried placeOrderAction call (same clientRequestId,
  // same order) never re-sends one that already went out — see
  // placeOrderAction's own comment. NULL for non-COD orders, which never
  // touch these columns.
  codUserEmailSentAt  DateTime?
  codAdminEmailSentAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]

  @@index([userId, createdAt])
  @@index([status, paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict on product deletion so we never lose the historical link to
  // a fulfilled item; if a product must be deleted, refund/close orders first.
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Frozen snapshots — never re-derived from Product later.
  productName  String
  productImage String?
  unitPrice    Int // frozen at time of order
  qty          Int
  lineTotal    Int // unitPrice * qty, denormalised for quick reads
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
